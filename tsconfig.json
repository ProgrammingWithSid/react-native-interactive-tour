{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",

    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "declaration": true,

    "types": [],

    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src/**/*"]
}
